<!-- knowledge-page.ejs -->
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>База знаний ЦТС</title>

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <!-- Шапка -->
    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний ЦТС</span>
      </a>

      <form class="search" action="/search" method="GET">
        <input type="text" name="q" placeholder="Поиск по базе знаний..." value="<%= typeof query !== 'undefined' ? query : '' %>" />
      </form>

      <a href="#" class="user">
        <span class="user-icon">👤</span>
        <span>Пользователь</span>
      </a>
    </header>

    <!--   Основная раскладка -->

    <div class="layout">
      <!--  Боковая панель    -->
      <%- include('sidebar') %>

      <!--  Основное содержимое -->
      <main class="content">
        <!-- breadcrumbs -->
        <%- include('breadcrumbs') %>

        <!--          Заголовок страницы          -->
        <div class="page-header">
          <!-- Левая часть: название и мета-инфо -->
          <div class="page-header-info">
            <h1><%= page_title %></h1>
            <div class="page-meta">
              Автор: <%= page_author || 'Не указан' %> · Изменено: <%= new
              Date(page_updated_at).toLocaleDateString('ru-RU') %>
            </div>
          </div>

          <!-- Правая часть: кнопки управления страницей -->
          <div class="page-header-actions">
            <a
              href="/edit/page/<%= page_category_slug %>/<%= page_slug %>"
              class="edit-button"
            >
              ✏️ Редактировать
            </a>

            <form
              method="POST"
              action="/edit/page/<%= page_category_slug %>/<%= page_slug %>/delete"
              style="display: inline"
              onsubmit="
                return confirm(
                  'Удалить страницу «' +
                    '<%= page_title %>' +
                    '»? Это действие необратимо.',
                );
              "
            >
              <button type="submit" class="delete-button">
                🗑️ Удалить страницу
              </button>
            </form>
          </div>
        </div>

        <!--==========================-->
        <!-- Основная область статьи-->
        <div class="page-layout">
          <!--    Содержание (нужно ли?)    -->

          <!--    Markdown → HTML  -->
          <article class="markdown"><%- page_content %></article>
        </div>
      </main>
    </div>
  </body>
</html>
