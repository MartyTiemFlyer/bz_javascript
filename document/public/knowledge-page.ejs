<!-- knowledge-page.ejs -->
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>База знаний ЦТС</title>

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <!-- Шапка -->
    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний ЦТС</span>
      </a>

      <!-- Поиск -->
      <form class="search" action="/search" method="GET">
        <input type="text" name="q" placeholder="Поиск по базе знаний..." value="<%= typeof query !== 'undefined' ? query : '' %>" />
        <button type="submit" class="search-button" aria-label="Найти">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                 stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <circle cx="11" cy="11" r="6.5" />
              <line x1="16" y1="16" x2="21" y2="21" />
            </svg>
        </button>
      </form>
      <!-- ---------------------- -->

      <% if (isAuthenticated) { %>
        <form method="POST" action="/logout" class="user-logout-form">
          <button type="submit" class="user">
            <span class="user-icon">👤</span>
            <span>Выйти</span>
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="user">
          <span class="user-icon">👤</span>
          <span>Войти для редактирования</span>
        </a>
      <% } %>
      </a>
    </header>

    <!--   Основная раскладка -->

    <div class="layout">
      <!--  Боковая панель    -->
      <%- include('sidebar') %>

      <!--  Основное содержимое -->
      <main class="content">
        <!-- breadcrumbs -->
        <%- include('breadcrumbs') %>

        <!--          Заголовок страницы          -->
        <div class="page-header">
          <!-- Левая часть: название и мета-инфо -->
          <div class="page-header-info">
            <h1><%= page_title %></h1>
            <div class="page-meta">
              Автор: <%= page_author || 'Не указан' %> · Изменено: <%= new
              Date(page_updated_at).toLocaleDateString('ru-RU') %>
            </div>
          </div>

          <!-- Правая часть: кнопки управления страницей -->
          <div class="page-header-actions">
            <a
              href="/edit/page/<%= page_category_slug %>/<%= page_slug %>"
              class="edit-button"
            >
              ✏️ Редактировать
            </a>
            <form
              method="POST"
              action="/edit/page/<%= page_category_slug %>/<%= page_slug %>/delete"
              style="display: inline"
              onsubmit="
                return confirm(
                  'Удалить страницу «' +
                    '<%= page_title %>' +
                    '»? Это действие необратимо.',
                );
              "
            >
              <button type="submit" class="delete-button">
                🗑️ Удалить страницу
              </button>
            </form>
            
            <div class="print-menu no-print" id="print-menu">
  <button type="button" class="print-menu-toggle" id="print-menu-btn"
          aria-haspopup="true" aria-expanded="false">
    🖨️ Печать <span class="print-menu-caret">▾</span>
  </button>

  <div class="print-menu-list" id="print-menu-list" hidden>
    <button type="button" class="print-menu-item" id="print-btn">
      <svg class="menu-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 2h8l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" fill="#fff" stroke="#9ca3af"/>
        <path d="M14 2v5h5" fill="#e5e7eb" stroke="#9ca3af"/>
        <rect x="2" y="12" width="15" height="7" rx="1.5" fill="#dc2626"/>
        <text x="9.5" y="17.6" font-size="5.6" font-weight="700" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif">PDF</text>
      </svg>
      <span class="menu-label">Печать / сохранить в PDF</span>
    </button>

    <button type="button" class="print-menu-item" id="xlsx-btn" hidden>
      <svg class="menu-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="3" fill="#16a34a"/>
        <path d="M8.5 8l7 8M15.5 8l-7 8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
      <span class="menu-label">Скачать Excel</span>
    </button>
    <button type="button" class="print-menu-item" id="word-btn">
      <svg class="menu-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="3" fill="#2563eb"/>
        <path d="M7 8l2 8 3-6 3 6 2-8" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="menu-label">Скачать Word</span>
    </button>

  </div>
</div>

          </div>
        </div>

        <!--==========================-->
        <!-- Основная область статьи-->
        <div class="page-layout" id="page-layout">
          <!--    Markdown → HTML  -->
          <article class="markdown"><%- page_content %></article>

          <!--    Содержание (строится скриптом)  -->
          <aside class="toc" id="toc" hidden>
            <div class="toc-title">Содержание</div>
            <ul id="toc-list"></ul>
          </aside>
        </div>
      </main>
    </div>
  <script>
  (function () {
    const article = document.querySelector('.markdown');
    const toc = document.getElementById('toc');
    const list = document.getElementById('toc-list');
    const layout = document.getElementById('page-layout');
    if (!article || !toc) return;
  
    const headings = [...article.querySelectorAll('h1, h2, h3')];
    if (headings.length < 2) return; // на коротких страницах оглавление не нужно
  
    // самый высокий уровень на странице считаем первым (отступ 0)
    const minLevel = Math.min(...headings.map(h => +h.tagName[1]));
  
    const links = headings.map((h, i) => {
      h.id = 'heading-' + (i + 1);
      const li = document.createElement('li');
      li.className = 'toc-l' + (+h.tagName[1] - minLevel + 1);
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent;
      li.appendChild(a);
      list.appendChild(li);
      return a;
    });
  
    toc.hidden = false;
    layout.classList.add('has-toc');
  
    // подсветка текущего раздела: последний заголовок, который уже прошли
    let ticking = false;
    function updateActive() {
      ticking = false;
      let current = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top <= 80) current = i;
      });
      links.forEach((a, i) => a.classList.toggle('active', i === current));
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(updateActive); }
    });
    updateActive();
  })();
  (function () {
    var btn = document.getElementById('print-btn');
    if (!btn) return;

    var originalTitle = document.title;

    window.addEventListener('beforeprint', function () {
      var h1 = document.querySelector('.content h1');
      if (h1 && h1.textContent.trim()) {
        document.title = h1.textContent.trim();
      }
    });
    window.addEventListener('afterprint', function () {
      document.title = originalTitle;
    });

    btn.addEventListener('click', function () { window.print(); });
  })();
  
  </script>
  <script>
(function () {
  var menu = document.getElementById('print-menu');
  var toggle = document.getElementById('print-menu-btn');
  var list = document.getElementById('print-menu-list');
  if (!menu || !toggle || !list) return;

  function setOpen(open) {
    list.hidden = !open;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  toggle.addEventListener('click', function (e) {
    e.stopPropagation();
    setOpen(list.hidden);
  });

  // клик по пункту закрывает меню
  list.addEventListener('click', function () { setOpen(false); });

  // клик вне меню и Escape тоже закрывают
  document.addEventListener('click', function (e) {
    if (!menu.contains(e.target)) setOpen(false);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') setOpen(false);
  });
})();
</script>
  <script src="/vendor/exceljs/dist/exceljs.min.js"></script> 
  <script src="/table-tools.js"></script>
  <script src="/word-export.js"></script>
  </body>
</html>
