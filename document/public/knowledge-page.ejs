<!-- knowledge-page.ejs -->
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>База знаний ЦТС</title>

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <!-- Шапка -->

    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний</span>
      </a>

      <div class="search">
        <input type="text" placeholder="Поиск по базе знаний..." />
      </div>

      <a href="#" class="user">
        <span class="user-icon">👤</span>
        <span>Пользователь</span>
      </a>
    </header>

    <!--   Основная раскладка -->

    <div class="layout">
      <!--  Боковая панель    -->
      <%- include('sidebar') %>

      <!--  Основное содержимое -->
      <main class="content">
        <!-- breadcrumbs -->
        <%- include('breadcrumbs') %>

        <!--          Заголовок страницы          -->
        <div class="page-header">
          <div>
            <h1><%= page_title %></h1>
            <div class="page-meta">
              Автор: <%= page_author || 'Не указан' %> · Изменено: <%= new
              Date(page_updated_at).toLocaleDateString('ru-RU') %>
            </div>
          </div>

          <a href="#" class="edit-button"> ✏️ Редактировать </a>
        </div>

        <!--==========================-->
        <!-- Основная область статьи-->
        <div class="page-layout">
          <!--    Содержание (нужно ли?)    -->

          <!--    Markdown → HTML  -->
          <article class="markdown"><%- page_content %></article>
        </div>
      </main>
    </div>
  </body>
</html>
