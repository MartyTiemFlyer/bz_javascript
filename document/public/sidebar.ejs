<!-- sidebar.ejs -->
<aside class="sidebar">
<!-- Кнопка создания -->
<a href="/edit/category/new" class="create-category-button">
  <span>＋</span>
  <span>Новая категория</span>
</a>
<a href="/edit/page/new" class="create-page-button">
  <span>＋</span>
  <span>Новая страница</span>
</a>


  <!-- Секции боковой панели -->
  <% sidebarSections.forEach(function(section) { %>
    <div class="sidebar-section">
      <a href="/<%= section.slug %>" class="sidebar-section-title" title="<%= section.title %>">
        <span class="sidebar-icon"><%= section.icon %></span>
        <span class="sidebar-section-text"><%= section.title %></span>
      </a>
      <% if (section.links.length > 0) { %>
        <div class="sidebar-links">
          <% section.links.forEach(function(link) { %>
            <a href="/<%= section.slug %>/<%= link.slug %>" class="sidebar-link" title="<%= link.title %>">
              <span class="page-icon">📄</span>
              <span class="sidebar-link-text"><%= link.title %></span>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% }); %>
</aside>