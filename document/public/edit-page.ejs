<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= mode === 'create' ? 'Новая страница' : 'Редактирование страницы' %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
      .edit-page-wrap {
      max-width: 1400px;  
      margin: 48px auto;
      padding: 0 24px;
    }

    .editor-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .editor-pane-title {
      font-size: 12px;
      font-weight: 600;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 6px;
    }

    .editor-split .field textarea {
      height: 560px;
      min-height: 560px;
      resize: none;
    }

    .preview-box {
      height: 560px;
      overflow-y: auto;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 16px 20px;
      background: #fff;
      box-sizing: border-box;
    }

    .preview-empty {
      color: #9ca3af;
      font-size: 14px;
    }

    @media (max-width: 900px) {
      .editor-split { grid-template-columns: 1fr; }
    }

    .edit-header {
      margin-bottom: 32px;
    }

    .edit-header h1 {
      font-size: 24px;
      margin: 0 0 6px;
    }

    .edit-header p {
      color: #6b7280;
      margin: 0;
      font-size: 14px;
    }

    .edit-card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 28px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .field {
      margin-bottom: 20px;
    }

    .field:last-of-type {
      margin-bottom: 0;
    }

    .field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
    }

    .field-row {
      display: flex;
      gap: 16px;
    }

    .field-row .field {
      flex: 1;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      box-sizing: border-box;
      font-family: inherit;
      transition: border-color 0.15s;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      outline: none;
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .field select {
      background: #fff;
      cursor: pointer;
    }

    .field textarea {
      resize: vertical;
      min-height: 380px;
      line-height: 1.6;
      font-family: 'SF Mono', 'Consolas', 'Monaco', monospace;
      font-size: 13px;
    }

    .field-hint {
      margin-top: 6px;
      font-size: 12px;
      color: #6b7280;
      line-height: 1.5;
    }

    .field-hint code {
      background: #f3f4f6;
      padding: 1px 5px;
      border-radius: 4px;
      font-size: 11px;
    }

    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid #f0f0f0;
    }

    .btn-primary {
      background: #6366f1;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-primary:hover {
      background: #4f46e5;
    }

    .btn-secondary {
      background: #fff;
      color: #374151;
      border: 1px solid #d1d5db;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    .btn-secondary:hover {
      background: #f9fafb;
    }

    .preview-box { position: relative; }
    .markdown img { max-width: 100%; height: auto; }

    .preview-hint { font-size: 12px; color: #9ca3af; margin: -2px 0 8px; }

    .img-resizer { display: none; position: absolute; border: 1px solid #6366f1; pointer-events: none; }
    .img-handle { position: absolute; width: 9px; height: 9px; background: #fff;
      border: 1px solid #6366f1; pointer-events: auto; }
    .img-handle.nw { left: -5px;  top: -5px;    cursor: nwse-resize; }
    .img-handle.ne { right: -5px; top: -5px;    cursor: nesw-resize; }
    .img-handle.se { right: -5px; bottom: -5px; cursor: nwse-resize; }
    .img-handle.sw { left: -5px;  bottom: -5px; cursor: nesw-resize; }
    .img-handle.e  { right: -5px; top: 50%; margin-top: -5px; cursor: ew-resize; }
    .img-handle.w  { left: -5px;  top: 50%; margin-top: -5px; cursor: ew-resize; }

  </style>
</head>
<body>
  <div class="edit-page-wrap">
    <div class="edit-header">
      <h1><%= mode === 'create' ? 'Новая страница' : `Редактирование: ${page.title}` %></h1>
      <p>Содержимое пишется в формате Markdown и автоматически превращается в оформленную страницу.</p>
    </div>

    <div class="edit-card">
      <form method="POST" action="<%= mode === 'create' ? '/edit/page/new' : `/edit/page/${current_category_slug}/${page.slug}` %>">
        <!-- Конфликт одновременных изменений -->
        <% if (typeof error !== 'undefined' && error === 'conflict') { %>
        <div class="error-banner">
          Пока вы редактировали, кто-то другой уже сохранил изменения этой страницы.
          Ваши правки не сохранены — откройте страницу заново и внесите их снова.
        </div>
      <% } %>
        <% if (typeof error !== 'undefined' && error === 'duplicate') { %>
        <div class="error-banner">
          Страница с таким адресом (slug) в этой категории уже существует.
          Измените slug или выберите другую категорию. Ваш текст сохранён.
        </div>
      <% } %>
      
        <div class="field-row">
          <div class="field">
            <label for="category_id">Категория</label>
            <select id="category_id" name="category_id" required>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.id %>" <%= page.category_id === cat.id ? 'selected' : '' %>>
                  <%= cat.title %>
                </option>
              <% }); %>
            </select>
          </div>

          <% if (mode === 'create') { %>
            <div class="field">
              <label for="slug">Slug (адрес страницы)</label>
              <input type="text" id="slug" name="slug" value="<%= page.slug %>" placeholder="script-1" pattern="[a-z0-9\-]+" required />
            </div>
          <% } %>
        </div>

        <% if (mode === 'create') { %>
          <div class="field-hint" style="margin-top: -12px; margin-bottom: 20px;">
            Slug — короткий адрес страницы на латинице, из которого формируется URL.
            Например, <code>script-1</code> в категории <code>scripts</code> даст адрес
            <code>/scripts/script-1</code>. Только строчные латинские буквы, цифры и дефис,
            без пробелов и русских букв.
          </div>
        <% } %>

        <% if (mode === 'edit') { %>
          <input type="hidden" name="expected_updated_at" value="<%= page.updated_at.toISOString() %>" />
        <% } %>

        <div class="field">
          <label for="title">Заголовок</label>
          <input type="text" id="title" name="title" value="<%= page.title %>" placeholder="Скрипт 1" required />
        </div>

        <div class="field">
          <label for="author">Автор</label>
          <input type="text" id="author" name="author" value="<%= page.author || '' %>" placeholder="Иван Иванов" />
        </div>

        
        <div class="attach-bar">
          <button type="button" id="attach-file-btn" class="btn-secondary">📎 Прикрепить файл</button>
          <input type="file" id="attach-file-input" style="display: none;" />
          <span id="attach-status" class="attach-status"></span>
        </div>
     

        <div class="editor-split">
          <div class="field">
            <div class="editor-pane-title">Markdown</div>
            <textarea id="content" name="content" placeholder="# Заголовок&#10;&#10;Текст статьи..."><%= page.content %></textarea>
          </div>
        
          <div class="field">
            <div class="editor-pane-title">Предпросмотр</div>
            <div class="preview-hint">Нажмите на картинку, чтобы изменить размер</div>
            <div class="preview-box">
              <article class="markdown" id="preview"></article>
            </div>
          </div>
        </div>

        <div class="field-hint">
          Пишите обычным текстом с разметкой Markdown: <code># Заголовок</code> — заголовок
          (после <code>#</code> нужен пробел), <code>**текст**</code> — жирный, <code>*текст*</code> — курсив,
          <code>- пункт</code> — список, <code>[текст](url)</code> — ссылка.
        <br>см. <a href="https://gist.github.com/Jekins/2bf2d0638163f1294637" target="_blank">руководство по Markdown</a> для справки.
        <br>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary">Сохранить</button>
          <a href="/" class="btn-secondary">Отмена</a>
        </div>
      </form>
    </div>
  </div>
  <script src="/vendor/markdown-it/browser/markdown-it.umd.min.js"></script>
<script>
  const md = window.markdownit();
  const defaultImage = md.renderer.rules.image;
  md.renderer.rules.image = (tokens, idx, options, env, self) => {
    const token = tokens[idx];
    const src = token.attrGet('src') || '';
    const m = src.match(/#w=(\d+)$/);
    if (m) {
      token.attrSet('src', src.replace(/#w=\d+$/, ''));
      token.attrSet('width', m[1]);
    }
    return defaultImage
      ? defaultImage(tokens, idx, options, env, self)
      : self.renderToken(tokens, idx, options);
  };
  
  const textarea = document.getElementById('content');
  const preview = document.getElementById('preview');

  function renderPreview() {
    const text = textarea.value.trim();

    preview.innerHTML = text
      ? md.render(textarea.value)
      : '<p class="preview-empty">Здесь появится результат по мере ввода…</p>';
  }

  let renderTimer;

  textarea.addEventListener('input', () => {
    clearTimeout(renderTimer);

    renderTimer = setTimeout(() => {
      renderPreview();
    }, 200); // 200 мс после последнего нажатия выполняется рендер
  });

  renderPreview(); // сразу показать текущий текст при открытии редактирования

  const previewBox = document.querySelector('.preview-box');

  const box = document.createElement('div');
  box.className = 'img-resizer';
  ['nw', 'ne', 'se', 'sw', 'e', 'w'].forEach(d => {
    const h = document.createElement('div');
    h.className = 'img-handle ' + d;
    h.dataset.dir = d;
    box.appendChild(h);
  });
  previewBox.appendChild(box);

  let currentImg = null;

  function placeBox() {
    if (!currentImg || !currentImg.isConnected) { box.style.display = 'none'; return; }
    const p = previewBox.getBoundingClientRect();
    const r = currentImg.getBoundingClientRect();
    Object.assign(box.style, {
      display: 'block',
      left: r.left - p.left + previewBox.scrollLeft + 'px',
      top: r.top - p.top + previewBox.scrollTop + 'px',
      width: r.width + 'px',
      height: r.height + 'px'
    });
  }

  function setImageWidth(index, width) {
    let i = -1;
    textarea.value = textarea.value.replace(
      /!\[([^\]]*)\]\(([^)\s#]+)(?:#w=\d+)?\)/g,
      (m, alt, url) => (++i === index ? `![${alt}](${url}#w=${width})` : m)
    );
  }

  preview.addEventListener('click', e => {
    currentImg = e.target.tagName === 'IMG' ? e.target : null;
    placeBox();
  });
  document.addEventListener('click', e => {
    if (!previewBox.contains(e.target)) { currentImg = null; placeBox(); }
  });
  previewBox.addEventListener('scroll', placeBox);

  box.addEventListener('pointerdown', e => {
    const dir = e.target.dataset.dir;
    if (!dir || !currentImg) return;
    e.preventDefault();

    const index = [...preview.querySelectorAll('img')].indexOf(currentImg);
    const startX = e.clientX;
    const startW = currentImg.getBoundingClientRect().width;
    const maxW = preview.clientWidth;
    let newW = startW;

    const onMove = ev => {
      const dx = ev.clientX - startX;
      newW = dir.includes('w') ? startW - dx : startW + dx;
      newW = Math.round(Math.min(maxW, Math.max(30, newW)));
      currentImg.style.width = newW + 'px';
      placeBox();
    };
    const onUp = () => {
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerup', onUp);
      setImageWidth(index, newW);
      renderPreview();
      currentImg = preview.querySelectorAll('img')[index] || null;
      placeBox();
    };
    document.addEventListener('pointermove', onMove);
    document.addEventListener('pointerup', onUp);
  });
</script>


<script>
  const attachBtn = document.getElementById('attach-file-btn');
  const attachInput = document.getElementById('attach-file-input');
  const attachStatus = document.getElementById('attach-status');
  const pageId = '<%= mode === "edit" ? page.id : "new" %>';

  const IMAGE_EXTENSIONS = ['.png', '.jpg', '.jpeg', '.gif', '.webp', '.svg'];

  attachBtn.addEventListener('click', () => {
    attachInput.click();
  });

  async function uploadFile(file) {
  if (!file) return;

  attachStatus.textContent = 'Загрузка...';
  attachStatus.classList.remove('error');

  const formData = new FormData();
  formData.append('file', file);

  try {
    const response = await fetch(`/api/uploads/${pageId}`, {
      method: 'POST',
      body: formData
    });

    const data = await response.json();

    if (!response.ok) {
      attachStatus.textContent = data.error || 'Ошибка загрузки';
      attachStatus.classList.add('error');
      return;
    }

    insertAtCursor(data.url, data.filename);
    attachStatus.textContent = `Прикреплено: ${data.filename}`;
  } catch (err) {
    attachStatus.textContent = 'Ошибка сети';
    attachStatus.classList.add('error');
  }
}

  attachInput.addEventListener('change', async () => {
    await uploadFile(attachInput.files[0]);
    attachInput.value = '';
  });
  
  // Вставка скриншота из буфера (Ctrl+V)
  textarea.addEventListener('paste', e => {
    const cd = e.clipboardData;
    if (!cd) return;
  
    // если в буфере есть обычный текст, вставляем его как всегда
    if (cd.types.includes('text/plain')) return;
  
    for (const item of cd.items) {
      if (item.kind === 'file' && item.type.startsWith('image/')) {
        const blob = item.getAsFile();
        if (!blob) continue;
      
        e.preventDefault();
        const ext = item.type.split('/')[1].replace('jpeg', 'jpg');
        const file = new File([blob], `screenshot-${Date.now()}.${ext}`, { type: item.type });
        uploadFile(file);
        return;
      }
    }
  });

  function insertAtCursor(url, filename) {
    const ext = url.slice(url.lastIndexOf('.')).toLowerCase();
    const isImage = IMAGE_EXTENSIONS.includes(ext);
    const markdown = isImage
      ? `![${filename}](${url}#w=600)`
      : `[${filename}](${url})`;

    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const before = textarea.value.slice(0, start);
    const after = textarea.value.slice(end);

    textarea.value = `${before}${markdown}${after}`;

    const newCursorPos = start + markdown.length;
    textarea.selectionStart = newCursorPos;
    textarea.selectionEnd = newCursorPos;
    textarea.focus();

    renderPreview(); // обновляем предпросмотр сразу после вставки
  }
</script>

</body>
</html>