<!-- шаблон для СПИСКА статей внутри категории -->
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>База знаний ЦТС</title>

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <!-- Шапка -->

    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний</span>
      </a>

      <div class="search">
        <input type="text" placeholder="Поиск по базе знаний..." />
      </div>

      <a href="#" class="user">
        <span class="user-icon">👤</span>
        <span>Пользователь</span>
      </a>
    </header>

    <!--   Основная раскладка -->

    <div class="layout">
      <!--  Боковая панель    -->
      <%- include('sidebar') %>

    
      <!--  Основное содержимое -->
      <main class="content">
        <!-- breadcrumbs -->
        <%- include('breadcrumbs') %>

        <!--          Заголовок страницы          -->
        <div class="page-header">
          

          <a href="#" class="edit-button"> ✏️ Редактировать категорию </a>
          <a href="#" class="delete-button"> 🗑️ Удалить категорию </a>
        </div>

        <!--==========================-->
        <!-- Основная область статьи-->
        <div class="page-layout">
          <!--    Содержание (нужно ли?)    -->

          <!--    Markdown → HTML  -->
          <article class="markdown">
            <ul class="page-list">
              <% pages.forEach(function(page) { %>
                <li>
                  <a href="/<%- category_slug %>/<%- page.slug %>"><%- page.title %></a>
                </li>
              <% }); %>
            </ul>
          </article>
        </div>
      </main>
    </div>
  </body>
</html>
