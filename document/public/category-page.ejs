<!-- шаблон для СПИСКА статей внутри категории -->
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>База знаний ЦТС</title>

    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <!-- Шапка -->

    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний</span>
      </a>

      <div class="search">
        <input type="text" placeholder="Поиск по базе знаний..." />
      </div>

      <a href="#" class="user">
        <span class="user-icon">👤</span>
        <span>Пользователь</span>
      </a>
    </header>

    <!--   Основная раскладка -->

    <div class="layout">
      <!--  Боковая панель    -->
      <%- include('sidebar') %>

    
      <!--  Основное содержимое -->
      <main class="content">
        <!-- breadcrumbs -->
        <%- include('breadcrumbs') %>

        <!--          Заголовок страницы          -->
        <div class="page-header">
          <div>
            <h1><%= category_title %></h1>
          </div>

            <div class="page-header-actions">
                <a href="/edit/category/<%= category_slug %>" class="edit-button"> ✏️ Редактировать категорию </a>

                <% if (pages.length === 0) { %>
                  <form method="POST" action="/edit/category/<%= category_slug %>/delete" style="display: inline;" onsubmit="return confirm('Удалить категорию «' + '<%= category_title %>' + '»? Это действие необратимо.');">
                    <button type="submit" class="delete-button">🗑️ Удалить категорию</button>
                  </form>
                <% } else { %>
                  <span class="delete-disabled-hint" title="Сначала удалите или перенесите все страницы этой категории">
                    🗑️ Удалить нельзя — в категории есть страницы
                  </span>
                <% } %>
              </div>
            </div>


        <!--==========================-->
        <!-- Основная область статьи-->
        <!--==========================-->
        <!-- Список страниц категории -->
        <div class="page-layout">
          <% if (pages.length === 0) { %>
            <p class="empty-state">В этой категории пока нет страниц.</p>
          <% } else { %>
            <ul class="page-list">
              <% pages.forEach(function(page) { %>
                <li>
                  <a href="/<%- category_slug %>/<%- page.slug %>"><%- page.title %></a>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </main>
    </div>
  </body>
</html>
