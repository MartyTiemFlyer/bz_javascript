<!-- index.ejs -->
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>База знаний ЦТС</title>

    <link rel="stylesheet" href="/style.css">
  </head>

  <body>
    <!-- Шапка -->

    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний</span>
      </a>

      <form class="search" action="/search" method="GET">
        <input type="text" name="q" placeholder="Поиск по базе знаний..." value="<%= typeof query !== 'undefined' ? query : '' %>" />
      </form>
      
      <a href="#" class="user">
        <span class="user-icon">👤</span>
        <span>Пользователь</span>
      </a>
    </header>

    <!--   Основная раскладка -->

    <div class="layout">
      
      <!--  Боковая панель    -->
      <%- include('sidebar') %>


      <!--  Основное содержимое -->
      <main class="content">
        <h1>Добро пожаловать в базу знаний</h1>

        <p>
          Здесь находится документация, инструкции и полезная информация
        </p>

        <div class="category-links">
        <% categories.forEach(function(category) { %>
          <a href="/<%- category.slug %>">
            <span><%- category.icon %></span>
            <span><%- category.title %></span>
          </a>
        <% }); %>
      </div>
      </main>
    
    
    </div>
  </body>

  </html>
