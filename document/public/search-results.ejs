<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title>Поиск: <%= query %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Шапка -->
    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">📚</span>
        <span>База знаний ЦТС</span>
      </a>

      <form class="search" action="/search" method="GET">
        <input type="text" name="q" placeholder="Поиск по базе знаний..." value="<%= typeof query !== 'undefined' ? query : '' %>" />
      </form>

      <% if (isAuthenticated) { %>
        <form method="POST" action="/logout" class="user-logout-form">
          <button type="submit" class="user">
            <span class="user-icon">👤</span>
            <span>Выйти</span>
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="user">
          <span class="user-icon">👤</span>
          <span>Войти для редактирования</span>
        </a>
      <% } %>
      </a>
    </header>

  <div class="layout">
    <%- include('sidebar') %>

    <main class="content">
      <h1>Результаты поиска: «<%= query %>»</h1>

      <% if (results.length === 0) { %>
        <p class="empty-state">Ничего не найдено.</p>
      <% } else { %>
        <ul class="page-list">
          <% results.forEach(function(r) { %>
            <li>
              <a href="/<%= r.category_slug %>/<%= r.slug %>"><%= r.title %></a>
              <span class="search-result-category">в разделе «<%= r.category_title %>»</span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </main>
  </div>
</body>
</html>